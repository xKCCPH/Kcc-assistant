<script>
    // Cohere API Key
    const COHERE_API_KEY = "SXtyeOjf58kEYdAEt57nlQO24V6X6FdycXLKkaGI";

    let currentSize = 15;
    function adjustFontSize(change) {
        currentSize += change;
        if (currentSize < 13) currentSize = 13;
        if (currentSize > 20) currentSize = 20;
        document.documentElement.style.setProperty('--base-font-size', currentSize + 'px');
    }

    async function sendMessage() {
        const inputField = document.getElementById("userInput");
        const chatBox = document.getElementById("chatBox");
        const sendBtn = document.getElementById("sendBtn");
        const userText = inputField.value.trim();
        
        if (!userText) return;

        chatBox.innerHTML += `<div class="message user">${userText}</div>`;
        inputField.value = "";
        chatBox.scrollTop = chatBox.scrollHeight;

        inputField.disabled = true;
        sendBtn.disabled = true;

        const loadingId = "loading-" + Date.now();
        chatBox.innerHTML += `<div class="message bot" id="${loadingId}">Nag-iisip <span class="loading-spinner">⏳</span></div>`;
        chatBox.scrollTop = chatBox.scrollHeight;

        const systemInstruction = `
Mahigpit na Patakaran: Ang tanging pagkukunan mo ng sagot ay ang opisyal na KCC Materials na nakasulat sa ibaba. Huwag gagamit ng panlabas na kaalaman o hula mula sa internet. Kung ang sagot ay hindi makikita sa mga araling ito, sabihin mong: "Wala po ito sa ating opisyal na aralin."

--- OPISYAL NA KCC LESSON MATERIALS ---

1. BE FRUITFUL, GOD IS FAITHFUL (Tatay Pastor, Oct 19, 2025):
- Ang batas ay nag-aalign sa bayan ng Diyos sa Kanyang kalooban (Exodus 19:3-6, 10-19; Jeremiah 31:33).
- Impluwensya ng Kaharian sa pisikal na mundo: Ang paghati sa Jordan (Joshua 3), pagbagsak ng pader ng Jericho (Joshua 6), at ang araw na tumigil (Joshua 10).
- Ang mga ritwal at Levitical law ay natapos dahil si Kristo ang naging huling sakripisyo (Hebrews 9:22, 1 Peter 2:9).

2. COVENANT (Tatay Pastor, Oct 26, 2025):
- Ginawa ng Diyos ang kasunduan kay Abram na magiging ama siya ng maraming bansa (Genesis 17). Ang tanda ay ang pagtutuli at pagpapalit ng pangalan (Abram>Abraham, Sarai>Sarah) na nagpapakita ng pagbabago ng pag-iisip at pamumuhay.
- Diyos ng mga henerasyon; tungkulin nating ituro sa susunod na henerasyon ang Kanyang kaharian (Deuteronomy 11).
- 4 na dahilan bakit nag-aaral ng Kaharian ng Diyos: 
  1) Banál na pagkatakot sa Diyos, 
  2) Ang Salita ng Hari ay pangwakas at ganap, 
  3) Ang Batas sa Kaharian ay di pabago-bago, 
  4) Non-negotiable ang moralidad at pagrespeto sa Kaharian.

3. FAMILIAL CONSECRATION (Tatay Pastor, Jan 18, 2026):
- Consecration: pagiging set apart para sa pamamahala ng Hari.
- Ang 7th day ay nagpapakita ng kaganapan at divine pattern ng pagpapahinga sa Kanya (Genesis 2:3).
- Si Noe ay itinalagang Kingdom administrator at ang arka ay nagsilbing kanlungan para sa micro-kingdom (pamilya).

4. INTENT OF THE CREATOR-KING & DEATH (Tatay Pastor, Aug 10):
- "When the END becomes the MEANS, and the MINOR becomes the MAJOR, then INJUSTICE (improper interpretation) is INEVITABLE" (Hosea 4:6, 2 Cor 4:4).
- Ang langit ang Main Kingdom at ang Earth ay Colony. Ang tao ay nilikha bilang mga local governors.
- Ang pagsuway (rebellion) ay nagdulot ng pag-alis ng Governor (Holy Spirit). 
- 3 Antas ng Kamatayan: 1) Pag-alis ng Espiritu ng Diyos, 2) Pag-alis ng tao sa presensya ng Diyos, 3) Paghiwalay ng espiritu sa pisikal na katawan.

5. LISTENING AND RESPONDING TO THE HOLY SPIRIT (Tatay Pastor, Sept 28, 2025):
- Holy Spirit: "Parakletos" (legal assistant, advocate, counsel for defense).
- 3 Gawain ng Banal na Espiritu: 1) Magtuturo ng lahat ng bagay tungkol kay Jesus, 2) Magpapaalala ng mga sinabi ni Jesus, 3) Patnubay sa gitna ng pagsubok.
- Tayo ang "Salt" (para mag-preserve) at "Light" (knowledge of truth) ng sanlibutan (Matthew 5:13-16). "Hindi tayo nagtuturo ng hindi natin ginagawa."

6. PURPOSE, POTENTIAL, AND PRINCIPLES (Tatay Pastor, May 4, 2025):
- Purpose (Why - original intent), Potential (What - built-in ability), Principle (How - guidelines/laws).
- Ang Iglesia ay ahensya na nag-a-represent ng Kaharian ng Diyos sa lupa.
- Utos na Be Fruitful (quality & quantity), Increase (mastery), Fill the Earth (expansion), at Subdue (dominate/influence).

7. REVISITING THE THEME - INFLUENCE OF THE KINGDOM (May 26):
- Tayo ay mga puno ng igos (fig trees) sa ubasan ng Panginoon (Luke 13).
- Ang turo ng mga Fariseo at Sadduceo ay parang lebadura (yeast) ng makataong tradisyon na nagligaw sa tao. Ang Kaharian ng Diyos ay may kapangyarihang magbago at umimpluwensya nang tahimik ngunit epektibo (Matthew 13:33).
- Hadlang sa paglago: Lumang mindset at kawalan ng paggalang (fear) sa Panginoon.

8. THE EXPANSION OF KINGDOM CULTURE (Aug 25):
- Lord's Prayer (Matthew 6:9-10): Pagpapalawak ng kultura ng langit dito sa lupa.
- Ang Salt ay sumisimbolo sa pag-iingat at pangangalaga sa ating pisikal na teritoryo at kalikasan (proper waste disposal).

9. PROCESS OF CITIZENSHIP IN THE HEAVENLY KINGDOM (July 2025):
- Kailangan ipanganak muli (sa tubig at Espiritu) upang maging citizen ng Kaharian (John 3).
- Hakbang sa Pagsisisi: 1) Kilalanin na nagkasala laban sa Diyos, 2) Unawain na ang kabayaran ay kamatayan, 3) Manampalataya kay Hesus, 4) Aminin at isuko ang mga kamalian, 5) Pagsisisan at magbago ng isip (Lucas 13:3), 6) Tanggapin si Hesus bilang Panginoon at Tagapagligtas (Romans 10:9-10).
---------------------------------------------
`;

        try {
            // Updated to Cohere V2 Endpoint
            const response = await fetch("https://api.cohere.com/v2/chat", {
                method: "POST",
                headers: { 
                    "Content-Type": "application/json",
                    "Authorization": `Bearer ${COHERE_API_KEY}`
                },
                body: JSON.stringify({
                    model: "command-r-plus",
                    messages: [
                        { role: "system", content: systemInstruction },
                        { role: "user", content: userText }
                    ]
                })
            });

            const data = await response.json();
            
            const loadingElem = document.getElementById(loadingId);
            if (loadingElem) loadingElem.remove();

            // Extract response from Cohere V2 JSON structure
            const botReply = data.message?.content?.[0]?.text || data.text || "Pasensya na, walang maibigay na sagot.";
            
            if (data.error || data.message?.includes?.("Error")) {
                chatBox.innerHTML += `<div class="message bot">May error sa API: ${data.error?.message || data.message}</div>`;
            } else {
                chatBox.innerHTML += `<div class="message bot">${botReply}</div>`;
            }
            
        } catch (error) {
            const loadingElem = document.getElementById(loadingId);
            if (loadingElem) loadingElem.remove();
            chatBox.innerHTML += `<div class="message bot">May problema sa koneksyon patungo sa Cohere API. Paki-subukan ulit.</div>`;
        } finally {
            inputField.disabled = false;
            sendBtn.disabled = false;
            inputField.focus();
            chatBox.scrollTop = chatBox.scrollHeight;
        }
    }

    function handleKeyPress(event) {
        if (event.key === "Enter") sendMessage();
    }
</script>
